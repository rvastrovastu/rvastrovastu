  "vastuZoneBest": "{zone, select, n{நுழைவாயில், வரவேற்பறை, பணப்பெட்டி, வீட்டு அலுவலகம்} nne{திறந்த வெளி, மருந்து வைப்பிடம், லேசான உடற்பயிற்சி} ne{பூஜை அறை, தியானம், குடிநீர் ஆதாரம்} ene{குடும்ப ஓய்வறை, விளையாட்டுப் பகுதி} e{நுழைவாயில், ஜன்னல்கள், வரவேற்பறை} ese{துணி துவைத்தல், சலவை இயந்திரம், மிக்ஸி-கிரைண்டர்} se{சமையலறை, மின் சாதனங்கள், இன்வெர்ட்டர்} sse{சமையலறை, உடற்பயிற்சி அறை, கவனமான பணியிடம்} s{படுக்கையறை, ஓய்வுப் பகுதி} ssw{கழிப்பறை, குப்பைத் தொட்டி, தேவையற்ற பொருட்கள் வைப்பிடம்} sw{பிரதான படுக்கையறை, கனமான பொருட்கள், லாக்கர்} wsw{படிப்பறை, நூலகம்} w{உணவருந்தும் இடம், குழந்தைகள் அறை} wnw{கழிப்பறை, சேமிப்பு அறை} nw{விருந்தினர் அறை, கேரேஜ், தயாரான பொருட்கள் வைப்பிடம்} nnw{தம்பதியர் படுக்கையறை, ஓய்வறை} other{{zone}}}",
  "vastuZoneAvoid": "{zone, select, n{கழிப்பறை, சமையலறை, கனமான பொருட்கள்} nne{கழிப்பறை, சமையலறை, சேமிப்பு அறை} ne{கழிப்பறை, சமையலறை, படிக்கட்டு, கனமான மரச்சாமான்கள்} ene{கழிப்பறை, கனமான பொருட்கள்} e{கழிப்பறை, சேமிப்பு அறை} ese{படுக்கையறை, படிப்பறை} se{தண்ணீர்த் தொட்டி, படுக்கையறை, கழிப்பறை} sse{தண்ணீர்த் தொட்டி, கழிப்பறை} s{தண்ணீர்த் தொட்டி, கழிப்பறை} ssw{படுக்கையறை, சமையலறை, நுழைவாயில்} sw{கழிப்பறை, நுழைவாயில், திறந்த வெளி, சமையலறை} wsw{கழிப்பறை, சமையலறை} w{சமையலறை, திறந்த நீர்நிலை} wnw{பூஜை அறை, படுக்கையறை} nw{பிரதான படுக்கையறை, பூஜை அறை} nnw{கழிப்பறை, சமையலறை} other{{zone}}}",
  "yogasTitle": "உங்கள் ஜாதகத்தில் உள்ள யோகங்கள்",
  "yogasIntro": "பாரம்பரிய பராசர விதிகளின்படி கிரக சேர்க்கைகள், முழு ராசி பாவ முறையில். எப்படி உருவாகிறது என்று பார்க்கத் தட்டுங்கள்.",
  "yogasNone": "இந்தச் செயலி சோதிக்கும் யோகங்களில் எதுவும் இந்த ஜாதகத்தில் உருவாகவில்லை.",
  "chartYogaCancelled": "பங்கம்",
  "chartYogaName": "{id, select, gajakesari{கஜகேசரி யோகம்} budhaditya{புதாதித்ய யோகம்} chandraMangal{சந்திர-மங்கள யோகம்} ruchaka{ருசக யோகம்} bhadra{பத்ர யோகம்} hamsa{ஹம்ச யோகம்} malavya{மாளவ்ய யோகம்} shasha{சச யோகம்} rajYoga{ராஜ யோகம்} yogakaraka{யோககாரக கிரகம்} dhanaYoga{தன யோகம்} viparitaRajYoga{விபரீத ராஜ யோகம்} amala{அமல யோகம்} kemadruma{கேமத்ரும யோகம்} other{{id}}}",
  "chartYogaMeaning": "{id, select, gajakesari{பாரம்பரியமாக ஞானம், மரியாதை, பின்னடைவுகளிலிருந்து மீளும் திறனுடன் தொடர்புடையது.} budhaditya{பாரம்பரியமாக அறிவுக்கூர்மை, தொடர்புத் திறன், உழைப்புக்கான அங்கீகாரத்துடன் தொடர்புடையது.} chandraMangal{பாரம்பரியமாக உத்வேகம், தொழில்முனைவு, சொந்த முயற்சியால் சம்பாதிப்பதுடன் தொடர்புடையது.} ruchaka{பஞ்ச மகாபுருஷ யோகங்களில் ஒன்று: தைரியம், ஆற்றல், தலைமை.} bhadra{பஞ்ச மகாபுருஷ யோகங்களில் ஒன்று: கூர்மையான அறிவு, பேச்சுத் திறன், வணிகம் அல்லது கல்வியில் திறமை.} hamsa{பஞ்ச மகாபுருஷ யோகங்களில் ஒன்று: ஞானம், நெறி, மதிக்கப்படும் தாராள இயல்பு.} malavya{பஞ்ச மகாபுருஷ யோகங்களில் ஒன்று: நாகரிகம், சுகம், அழகு மற்றும் கலைகளில் ரசனை.} shasha{பஞ்ச மகாபுருஷ யோகங்களில் ஒன்று: ஒழுக்கம், சகிப்புத்தன்மை, காலப்போக்கில் வளரும் அதிகாரம்.} rajYoga{முயற்சியும் அதிர்ஷ்டமும் இணைவது; பாரம்பரியமாக அந்தஸ்து, பொறுப்பு உயர்வுடன் தொடர்புடையது.} yogakaraka{உங்கள் லக்னத்துக்கு இந்தக் கிரகம் கேந்திரம், திரிகோணம் இரண்டுக்கும் அதிபதி; எனவே அதன் தசையும் நிலையும் கூடுதல் முக்கியத்துவம் பெறுகின்றன.} dhanaYoga{வருமானம், அதிர்ஷ்ட பாவங்களின் சேர்க்கை; பாரம்பரியமாகச் செல்வச் சேர்க்கையுடன் தொடர்புடையது.} viparitaRajYoga{கடினமான பாவங்களின் அதிபதிகள் கடினமான பாவங்களில்; பாரம்பரியமாகத் தடைகளுக்குப் பின் வெற்றி தரும்.} amala{பாரம்பரியமாக நற்பெயர், நிலையான மரியாதை தரும் நடத்தையுடன் தொடர்புடையது.} kemadruma{பாரம்பரியமாக உணர்வு ரீதியான சுயசார்பின் தேவையாகப் படிக்கப்படுகிறது. பிற கிரக நிலைகளால் இது அடிக்கடி பங்கமடைகிறது.} other{{id}}}",
  "chartYogaRule": "{id, select, gajakesari{சந்திரனிலிருந்து கேந்திரத்தில் (1, 4, 7 அல்லது 10) குரு.} budhaditya{சூரியனும் புதனும் ஒரே ராசியில்.} chandraMangal{சந்திரனும் செவ்வாயும் ஒரே ராசியில்.} ruchaka{செவ்வாய் ஆட்சி அல்லது உச்சத்தில், லக்னத்திலிருந்து கேந்திரத்தில்.} bhadra{புதன் ஆட்சி அல்லது உச்சத்தில், லக்னத்திலிருந்து கேந்திரத்தில்.} hamsa{குரு ஆட்சி அல்லது உச்சத்தில், லக்னத்திலிருந்து கேந்திரத்தில்.} malavya{சுக்கிரன் ஆட்சி அல்லது உச்சத்தில், லக்னத்திலிருந்து கேந்திரத்தில்.} shasha{சனி ஆட்சி அல்லது உச்சத்தில், லக்னத்திலிருந்து கேந்திரத்தில்.} rajYoga{ஒரு கேந்திராதிபதியும் ஒரு திரிகோணாதிபதியும் ஒரே ராசியில்.} yogakaraka{லக்னத்திலிருந்து 4, 7 அல்லது 10இல் ஒன்றுக்கும், 5 அல்லது 9இல் ஒன்றுக்கும் அதிபதி.} dhanaYoga{2 அல்லது 11ஆம் அதிபதி 1, 5 அல்லது 9ஆம் அதிபதியுடன் (அல்லது ஒருவருக்கொருவர்) ஒரே ராசியில்.} viparitaRajYoga{6, 8 அல்லது 12ஆம் அதிபதி 6, 8 அல்லது 12ஆம் வீட்டில்.} amala{லக்னம் அல்லது சந்திரனிலிருந்து 10ஆம் வீட்டில் புதன், குரு அல்லது சுக்கிரன்.} kemadruma{சந்திரனிலிருந்து 2 அல்லது 12ஆம் வீட்டில் சூரியன், ராகு, கேது தவிர வேறு கிரகம் இல்லை.} other{{id}}}",
