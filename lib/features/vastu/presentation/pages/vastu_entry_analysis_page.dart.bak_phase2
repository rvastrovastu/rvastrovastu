  const _UnavailableAssessmentCard({required this.segment, required this.l10n});

  final VastuEntrySegment segment;
  final AppLocalizations l10n;

  @override
  Widget build(BuildContext context) {
    final colors = Theme.of(context).colorScheme;

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(22),
      decoration: BoxDecoration(
        color: colors.surfaceContainerLow,
        borderRadius: BorderRadius.circular(24),
        border: Border.all(color: colors.outlineVariant),
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Icon(Icons.info_outline, color: colors.primary),
          const SizedBox(width: 14),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  segment.code,
                  style: Theme.of(
                    context,
                  ).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.w800),
                ),
                const SizedBox(height: 6),
                Text(
                  l10n.vastuAssessmentUnavailable,
                  style: Theme.of(
                    context,
                  ).textTheme.bodyLarge?.copyWith(height: 1.45),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

String _localizedDirection(
  AppLocalizations l10n,
  VastuEntryDirection direction,
) {
  switch (direction) {
    case VastuEntryDirection.north:
      return l10n.vastuNorth;
    case VastuEntryDirection.east:
      return l10n.vastuEast;
    case VastuEntryDirection.south:
      return l10n.vastuSouth;
    case VastuEntryDirection.west:
      return l10n.vastuWest;
    case VastuEntryDirection.northeast:
    case VastuEntryDirection.southeast:
    case VastuEntryDirection.southwest:
    case VastuEntryDirection.northwest:
      return direction.name;
  }
}

String _localizedSegment(AppLocalizations l10n, VastuEntrySegment segment) {
  switch (segment) {
    case VastuEntrySegment.w4:
      return l10n.vastuW4;
    case VastuEntrySegment.w5:
      return l10n.vastuW5;
    default:
      return segment.code;
  }
}

String _localizedAssessmentLabel(
  AppLocalizations l10n,
  VastuAssessmentLevel level,
) {
  switch (level) {
    case VastuAssessmentLevel.favorable:
      return l10n.vastuFavorable;
    case VastuAssessmentLevel.neutral:
      return l10n.vastuNeutral;
    case VastuAssessmentLevel.challenging:
      return l10n.vastuChallenging;
  }
}

String _localizedDeity(AppLocalizations l10n, String key) {
  switch (key) {
    case 'vastuPushpadanta':
      return l10n.vastuPushpadanta;
    case 'vastuVaruna':
      return l10n.vastuVaruna;
    default:
      throw ArgumentError('Unsupported Vastu deity localization key: $key');
  }
}

String _localizedSummary(AppLocalizations l10n, String key) {
  switch (key) {
    case 'vastuW4Summary':
      return l10n.vastuW4Summary;
    case 'vastuW5Summary':
      return l10n.vastuW5Summary;
    default:
      throw ArgumentError('Unsupported Vastu summary localization key: $key');
  }
}

class _AssessmentCard extends StatelessWidget {
  const _AssessmentCard({required this.assessment, required this.l10n});

  final VastuEntryAssessment assessment;
  final AppLocalizations l10n;

  @override
  Widget build(BuildContext context) {
    final colors = Theme.of(context).colorScheme;

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: colors.primaryContainer,
        borderRadius: BorderRadius.circular(28),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Icon(Icons.home_outlined, size: 32, color: colors.onPrimaryContainer),
          const SizedBox(height: 18),
          Text(
            assessment.segment.code,
            style: Theme.of(context).textTheme.headlineMedium?.copyWith(
              color: colors.onPrimaryContainer,
              fontWeight: FontWeight.w800,
            ),
          ),
          const SizedBox(height: 6),
          Text(
            l10n.vastuAssessment,
            style: Theme.of(context).textTheme.labelLarge?.copyWith(
              color: colors.onPrimaryContainer,
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 6),
          Text(
            _localizedAssessmentLabel(l10n, assessment.level),
            style: Theme.of(context).textTheme.titleLarge?.copyWith(
              color: colors.onPrimaryContainer,
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 16),
          Text(
            l10n.vastuTraditionalAssessment,
            style: Theme.of(context).textTheme.labelLarge?.copyWith(
              color: colors.onPrimaryContainer,
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 6),
          Text(
            _localizedDeity(l10n, assessment.deityKey),
            style: Theme.of(context).textTheme.titleLarge?.copyWith(
              color: colors.onPrimaryContainer,
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 14),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 7),
            decoration: BoxDecoration(
              color: colors.surface.withValues(alpha: 0.7),
              borderRadius: BorderRadius.circular(999),
            ),
            child: Text(
              _localizedAssessmentLabel(l10n, assessment.level),
              style: TextStyle(
                color: colors.onSurface,
                fontWeight: FontWeight.w700,
              ),
            ),
          ),
          const SizedBox(height: 16),
          Text(
            _localizedSummary(l10n, assessment.summaryKey),
            style: Theme.of(context).textTheme.bodyLarge?.copyWith(
              color: colors.onPrimaryContainer,
              height: 1.5,
            ),
          ),
        ],
      ),
    );
  }
}

