
import 'package:rv_astro_vastu/features/astrology/presentation/pages/kundali_loader_page.dart';
import 'package:rv_astro_vastu/features/auth/presentation/pages/auth_page.dart';
import 'package:rv_astro_vastu/features/home/presentation/pages/home_page.dart';
import 'package:go_router/go_router.dart';

import '../features/birth_profile/presentation/pages/birth_profile_page.dart';
import '../features/onboarding/presentation/pages/onboarding_page.dart';
import '../features/splash/presentation/pages/splash_page.dart';

abstract final class AppRouter {
  static final router = GoRouter(
    initialLocation: '/splash',
    routes: [
      GoRoute(
        path: '/kundali',
        builder: (context, state) => const KundaliLoaderPage(),
      ),
          );
        },
      ),
      GoRoute(path: '/auth', builder: (context, state) => const AuthPage()),
      GoRoute(path: '/splash', builder: (context, state) => const SplashPage()),
      GoRoute(
        path: '/onboarding',
        builder: (context, state) => const OnboardingPage(),
      ),
      GoRoute(
        path: '/birth-profile',
        builder: (context, state) => const BirthProfilePage(),
      ),
      GoRoute(path: '/home', builder: (context, state) => const HomePage()),
    ],
  );
}
