kclass RashiHouse {
  final int house;
  final String sign;
  final List<String> planets;

  const RashiHouse({
    required this.house,
    required this.sign,
    required this.planets,
  });

  bool get hasPlanets => planets.isNotEmpty;

  String get planetSummary {
    if (planets.isEmpty) {
      return 'No planets';
    }

    return planets.join(', ');
  }
}

class RashiChart {
  final List<RashiHouse> houses;

  const RashiChart({
    required this.houses,
  });

  RashiHouse? house(int number) {
    for (final item in houses) {
      if (item.house == number) {
        return item;
      }
    }

    return null;
  }

  RashiHouse? get firstHouse => house(1);

  List<RashiHouse> get occupiedHouses {
    return houses.where((house) => house.hasPlanets).toList();
  }
}
